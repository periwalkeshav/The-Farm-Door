# ---------------------------------------------------------------------------
# The Farm Door store: environment variables
# Copy to .env.local for development. On the live host, set these in the
# hosting provider's environment settings. Never commit real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@host:5432/farmdoor
# Optional: max connections per server instance (default 10)
# DATABASE_POOL_MAX=10

# Public address of the site, no trailing slash (used in emails and callbacks)
APP_URL=https://thefarmdoor.com

# Random secret for signing login codes and tokens (at least 32 characters).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# 32-byte key, base64, for encrypting staff 2-step verification secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later disconnects every staff authenticator app.
ENCRYPTION_KEY=

# Shared secret your scheduler sends to /api/cron/tick (Authorization: Bearer <secret>)
CRON_SECRET=

# --- Payments -------------------------------------------------------------
# razorpay (real) or mock (simulated, development only; refused in production)
PAYMENTS_PROVIDER=razorpay
# From Razorpay Dashboard > Account & Settings > API Keys (rzp_test_... for test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when creating the webhook in Razorpay Dashboard > Webhooks
RAZORPAY_WEBHOOK_SECRET=

# --- Shipping -------------------------------------------------------------
# shiprocket (real) or mock (simulated, development only; refused in production)
SHIPPING_PROVIDER=shiprocket
# A dedicated Shiprocket API user (Settings > API > Configure > Create an API user)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# The pickup location nickname exactly as saved in Shiprocket (Settings > Pickup Addresses)
SHIPROCKET_PICKUP_LOCATION=
# Token you set on the Shiprocket tracking webhook; sent back in the x-api-key header
SHIPROCKET_WEBHOOK_TOKEN=

# --- Email ----------------------------------------------------------------
# smtp (real) or log (development: emails are stored in the admin "Email log" and printed)
EMAIL_TRANSPORT=smtp
# e.g. smtps://username:password@smtp.example.com:465
SMTP_URL=
EMAIL_FROM=The Farm Door <orders@thefarmdoor.com>

# --- WhatsApp order updates (optional; needs Meta approval first) -----------
# off | log (development: recorded in Admin > Email log only) | cloud (Meta WhatsApp Cloud API)
WHATSAPP_TRANSPORT=off
# A permanent System User token and the phone number id, from Meta's WhatsApp Manager
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Graph API version; confirm the newest stable one in Meta's changelog
WHATSAPP_GRAPH_VERSION=v22.0
WHATSAPP_TEMPLATE_LANG=en

# --- Sign in with Google (optional) ----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Never set this on the live site.
# ALLOW_MOCK_PROVIDERS=false

# --- Visitor IP addresses (rate limits, audit log) ---------------------------
# true when every request reaches the app through Cloudflare: on Render (its edge runs on
# Cloudflare), and when thefarmdoor.com is proxied by your own Cloudflare account. The IP is then
# read from Cloudflare's CF-Connecting-IP header, which visitors can't fake. Leave false locally
# and on hosts without Cloudflare. DEPLOYMENT.md, "Visitor IP addresses", shows how to check it.
TRUST_CLOUDFLARE=false

# --- Staff 2-step verification -------------------------------------------------
# "off" lets staff sign in to the admin with email and password only (no authenticator-app code).
# For local development and demos; the admin shows a warning bar while it's off.
# Leave this unset (or "required") on the live site.
# STAFF_TWO_STEP=required
