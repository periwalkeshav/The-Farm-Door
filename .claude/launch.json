{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "store",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "store",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "store-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd store && APP_URL=http://localhost:3200 ALLOW_MOCK_PROVIDERS=true npx next start -p 3200"
      ],
      "port": 3200
    }
  ]
}